#: includes/class-wpsrd-block-editor.php:57
msgid "Revisions"
msgstr "Révisions"

#: includes/class-wpsrd-block-editor.php:58
#: includes/class-wpsrd-classic-editor.php:121
msgid "Purge"
msgstr "Purger"

#: includes/class-wpsrd-block-editor.php:59
#: includes/class-wpsrd-classic-editor.php:90
msgid "Purging…"
msgstr "Purge en cours…"

#: includes/class-wpsrd-block-editor.php:60
msgid "No revision to delete."
msgstr "Aucune révision à supprimer."

#: includes/class-wpsrd-block-editor.php:61
msgid "The revisions could not be deleted."
msgstr "Les révisions n'ont pas pu être supprimées."

#. translators: %s: number of deleted revisions.
#: includes/class-wpsrd-block-editor.php:63
#, php-format
msgid "%s revision deleted."
msgstr "%s révision supprimée."

#. translators: %s: number of deleted revisions.
#: includes/class-wpsrd-block-editor.php:65
#, php-format
msgid "%s revisions deleted."
msgstr "%s révisions supprimées."

#. translators: %s: number of revisions.
#: includes/class-wpsrd-block-editor.php:67
#, php-format
msgid "%s revision"
msgstr "%s révision"

#. translators: %s: number of revisions.
#: includes/class-wpsrd-block-editor.php:69
#, php-format
msgid "%s revisions"
msgstr "%s révisions"

#: includes/class-wpsrd-bulk-actions.php:50
msgid "Purge revisions"
msgstr "Purger les révisions"

#: includes/class-wpsrd-classic-editor.php:91
msgid "Purged"
msgstr "Purgé"

#: includes/class-wpsrd-classic-editor.php:92
msgid "Deleting…"
msgstr "Suppression en cours…"

#: includes/class-wpsrd-classic-editor.php:93
msgid "Deleted"
msgstr "Supprimé"

#: includes/class-wpsrd-classic-editor.php:94
msgid "Something went wrong, please reload the page."
msgstr "Une erreur est survenue, veuillez recharger la page."

#: includes/class-wpsrd-classic-editor.php:95
msgid "Delete"
msgstr "Supprimer"

#. translators: %s: revision label, for instance its date.
#: includes/class-wpsrd-classic-editor.php:97
#, php-format
msgid "Delete the revision %s"
msgstr "Supprimer la révision %s"

#: includes/class-wpsrd-classic-editor.php:165
#: includes/class-wpsrd-rest-controller.php:108
msgid "You are not allowed to delete the revisions of this post."
msgstr "Vous n'êtes pas autorisé à supprimer les révisions de cette publication."

#. translators: %s: number of deleted revisions.
#: includes/class-wpsrd-notices.php:61
#, php-format
msgid "%s revision has been deleted."
msgid_plural "%s revisions have been deleted."
msgstr[0] "%s révision a été supprimée."
msgstr[1] "%s révisions ont été supprimées."

#: includes/class-wpsrd-notices.php:65
msgid "No revision has been deleted."
msgstr "Aucune révision n'a été supprimée."

#: includes/class-wpsrd-notices.php:72
#, php-format
msgid "%s post was skipped because you are not allowed to delete it."
msgid_plural "%s posts were skipped because you are not allowed to delete them."
msgstr[0] "%s publication a été ignorée car vous n'êtes pas autorisé à la supprimer."
msgstr[1] "%s publications ont été ignorées car vous n'êtes pas autorisé à les supprimer."

#: includes/class-wpsrd-notices.php:82
msgid "Some revisions could not be deleted."
msgstr "Certaines révisions n'ont pas pu être supprimées."

#: includes/class-wpsrd-notices.php:122
msgid ""
"Post revisions are disabled on this site: the \"Simple Revisions Delete\" "
"plugin has nothing to do here."
msgstr "Les révisions sont désactivées sur ce site : l'extension « Simple Revisions Delete » n'a aucune raison d'y être installée."

#: includes/class-wpsrd-notices.php:124
msgid "Dismiss this notice permanently"
msgstr "Masquer définitivement cette notification"

#: includes/class-wpsrd-notices.php:147
msgid "You are not allowed to do this."
msgstr "Vous n'êtes pas autorisé à faire cela."

#: includes/class-wpsrd-plugin.php:56
msgid "More b*web plugins"
msgstr "Plus d'extensions b*web"

#: includes/class-wpsrd-plugin.php:62
msgid "Donate to this plugin"
msgstr "Faire un don pour cette extension"

#: includes/class-wpsrd-rest-controller.php:39
msgid "ID of the post owning the revisions."
msgstr "Identifiant de la publication à laquelle appartiennent les révisions."

#: includes/class-wpsrd-rest-controller.php:72
msgid "ID of the revision to delete."
msgstr "Identifiant de la révision à supprimer."

#: includes/class-wpsrd-rest-controller.php:100
msgid "This post does not exist."
msgstr "Cette publication n'existe pas."

#: includes/class-wpsrd-revisions.php:130
msgid "This revision does not belong to this post."
msgstr "Cette révision n'appartient pas à cette publication."

#: includes/class-wpsrd-revisions.php:144
msgid "The revision could not be deleted."
msgstr "La révision n'a pas pu être supprimée."